{
  "name": "furnicore-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "FurniCore ERP — Furniture Management System",
  "scripts": {
    "dev": "pnpm --parallel --filter @furnicore/web --filter @furnicore/api dev",
    "dev:web": "pnpm --filter @furnicore/web dev",
    "dev:api": "pnpm --filter @furnicore/api dev",
    "build": "pnpm --recursive build",
    "db:generate": "pnpm --filter @furnicore/database generate",
    "db:migrate": "pnpm --filter @furnicore/database migrate",
    "db:push": "pnpm --filter @furnicore/database push",
    "db:seed": "pnpm --filter @furnicore/database seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.29.3"
}
