datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  ADMIN
  ACCOUNTANT
  PRODUCTION_MANAGER
  WAREHOUSE_MANAGER
  SALES_MANAGER
  WORKER
}

enum WarehouseType {
  RAW_MATERIALS
  FINISHED_PRODUCTS
}

enum ProductCategory {
  WARDROBE
  TABLE
  BED
  KITCHEN
  SOFA
  OTHER
}

enum MaterialCategory {
  WOOD
  MDF
  CHIPBOARD
  PLYWOOD
  HARDWARE_SCREWS
  HARDWARE_HINGES
  HARDWARE_HANDLES
  HARDWARE_RAILS
  GLUE
  PAINT
  VARNISH
  FABRIC
  FOAM
  OTHER
}

enum MovementType {
  RECEIPT
  ISSUE
  TRANSFER
  ADJUSTMENT
  RESERVATION
  SHIPMENT
}

enum ProductionStatus {
  DRAFT
  PLANNED
  IN_PROGRESS
  QUALITY_CHECK
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ExpenseCategory {
  MATERIALS
  ELECTRICITY
  GAS
  WATER
  RENT
  PAYROLL
  TRANSPORT
  REPAIRS
  EQUIPMENT
  MARKETING
  OTHER
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  role         Role          @default(WORKER)
  phone        String?
  avatarUrl    String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  movements    StockMovement[]
  productionOrders ProductionOrder[] @relation("SupervisorOrders")
  salesOrders  SalesOrder[]
  expenses     Expense[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Warehouse {
  id          String        @id @default(uuid())
  code        String        @unique // WH-1 or WH-2
  name        String
  type        WarehouseType
  description String?
  address     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  stockBalances  StockBalance[]
  stockMovements StockMovement[]

  @@map("warehouses")
}

model Material {
  id              String           @id @default(uuid())
  sku             String           @unique
  name            String
  category        MaterialCategory
  unit            String           @default("шт")
  minStockLevel   Decimal          @default(0) @db.Decimal(12, 3)
  purchaseCostKZT Decimal          @default(0) @db.Decimal(14, 2)
  location        String?
  supplierId      String?
  supplier        Supplier?        @relation(fields: [supplierId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  stockBalances   StockBalance[]
  stockMovements  StockMovement[]
  recipeItems     RecipeItem[]

  @@map("materials")
}

model Product {
  id                String          @id @default(uuid())
  sku               String          @unique
  name              String
  category          ProductCategory
  description       String?
  dimensions        String?         // e.g. "2200x1600x600 мм"
  productionCostKZT Decimal         @default(0) @db.Decimal(14, 2)
  salePriceKZT      Decimal         @default(0) @db.Decimal(14, 2)
  isActive          Boolean         @default(true)
  imageUrl          String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  variants          ProductVariant[]
  stockBalances     StockBalance[]
  stockMovements    StockMovement[]
  recipes           Recipe[]
  productionOrders  ProductionOrder[]
  salesOrderItems   SalesOrderItem[]

  @@map("products")
}

model ProductVariant {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku              String   @unique
  name             String
  dimensions       String?
  colorVariant     String?
  extraPriceKZT    Decimal  @default(0) @db.Decimal(14, 2)
  createdAt        DateTime @default(now())

  @@map("product_variants")
}

model StockBalance {
  id            String     @id @default(uuid())
  warehouseId   String
  warehouse     Warehouse  @relation(fields: [warehouseId], references: [id])
  materialId    String?
  material      Material?  @relation(fields: [materialId], references: [id])
  productId     String?
  product       Product?   @relation(fields: [productId], references: [id])
  currentStock  Decimal    @default(0) @db.Decimal(12, 3)
  reservedStock Decimal    @default(0) @db.Decimal(12, 3)
  minLevel      Decimal    @default(0) @db.Decimal(12, 3)
  lastCountedAt DateTime?
  updatedAt     DateTime   @updatedAt

  @@unique([warehouseId, materialId])
  @@unique([warehouseId, productId])
  @@map("stock_balances")
}

model StockMovement {
  id              String       @id @default(uuid())
  movementNumber  String       @unique // e.g. MOV-2026-0001
  type            MovementType
  warehouseId     String
  warehouse       Warehouse    @relation(fields: [warehouseId], references: [id])
  materialId      String?
  material        Material?    @relation(fields: [materialId], references: [id])
  productId       String?
  product         Product?     @relation(fields: [productId], references: [id])
  quantity        Decimal      @db.Decimal(12, 3)
  unit            String
  unitCostKZT     Decimal      @default(0) @db.Decimal(14, 2)
  totalCostKZT    Decimal      @default(0) @db.Decimal(14, 2)
  referenceNumber String?      // e.g. PO-102 or SO-501
  notes           String?
  createdById     String?
  createdBy       User?        @relation(fields: [createdById], references: [id])
  createdAt       DateTime     @default(now())

  @@map("stock_movements")
}

model Recipe {
  id               String            @id @default(uuid())
  productId        String
  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  name             String
  version          String            @default("1.0")
  notes            String?
  isActive         Boolean           @default(true)
  laborHours       Decimal           @default(0) @db.Decimal(8, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  items            RecipeItem[]
  productionOrders ProductionOrder[]

  @@map("recipes")
}

model RecipeItem {
  id               String   @id @default(uuid())
  recipeId         String
  recipe           Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  materialId       String
  material         Material @relation(fields: [materialId], references: [id])
  quantityRequired Decimal  @db.Decimal(12, 3)
  unit             String
  notes            String?

  @@map("recipe_items")
}

model ProductionOrder {
  id                 String           @id @default(uuid())
  orderNumber        String           @unique // e.g. PRD-2026-0001
  productId          String
  product            Product          @relation(fields: [productId], references: [id])
  recipeId           String?
  recipe             Recipe?          @relation(fields: [recipeId], references: [id])
  plannedQuantity    Int
  completedQuantity  Int              @default(0)
  status             ProductionStatus @default(DRAFT)
  plannedStartDate   DateTime
  plannedEndDate     DateTime
  actualStartDate    DateTime?
  actualEndDate      DateTime?
  supervisorId       String?
  supervisor         User?            @relation("SupervisorOrders", fields: [supervisorId], references: [id])
  totalActualCostKZT Decimal          @default(0) @db.Decimal(14, 2)
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("production_orders")
}

model Supplier {
  id            String     @id @default(uuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  materials     Material[]

  @@map("suppliers")
}

model Customer {
  id          String       @id @default(uuid())
  name        String
  companyName String?
  phone       String
  email       String?
  address     String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  salesOrders SalesOrder[]

  @@map("customers")
}

model SalesOrder {
  id                String           @id @default(uuid())
  orderNumber       String           @unique // e.g. ORD-2026-0001
  customerId        String
  customer          Customer         @relation(fields: [customerId], references: [id])
  status            OrderStatus      @default(PENDING)
  totalAmountKZT    Decimal          @default(0) @db.Decimal(14, 2)
  depositAmountKZT  Decimal          @default(0) @db.Decimal(14, 2)
  discountAmountKZT Decimal          @default(0) @db.Decimal(14, 2)
  deliveryAddress   String?
  notes             String?
  createdById       String?
  createdBy         User?            @relation(fields: [createdById], references: [id])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  items             SalesOrderItem[]

  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(uuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Int
  unitPriceKZT Decimal    @db.Decimal(14, 2)
  totalPriceKZT Decimal   @db.Decimal(14, 2)

  @@map("sales_order_items")
}

model Expense {
  id            String          @id @default(uuid())
  expenseNumber String          @unique // e.g. EXP-2026-0001
  category      ExpenseCategory
  amountKZT     Decimal         @db.Decimal(14, 2)
  paymentDate   DateTime
  description   String
  payee         String?
  createdById   String?
  createdBy     User?           @relation(fields: [createdById], references: [id])
  createdAt     DateTime        @default(now())

  @@map("expenses")
}

model AuditLog {
  id            String   @id @default(uuid())
  entity        String
  entityId      String
  action        String
  diffJson      String?  @db.Text
  performedById String?
  performedBy   User?    @relation(fields: [performedById], references: [id])
  createdAt     DateTime @default(now())

  @@map("audit_logs")
}
