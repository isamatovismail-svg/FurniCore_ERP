# ==============================================================================
# FurniCore ERP — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# NEVER commit the real .env file with production credentials to Git!
# ==============================================================================

# Application Mode & Security
# In production: DEBUG must be set to False
DEBUG=False
# Generate a cryptographically strong secret key (e.g.: python -c "import secrets; print(secrets.token_urlsafe(50))")
SECRET_KEY=replace-with-a-cryptographically-secure-random-key-in-production

# Hostnames & Origins (comma-separated, no spaces)
ALLOWED_HOSTS=erp.furnicore.kz,www.erp.furnicore.kz,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://erp.furnicore.kz,https://www.erp.furnicore.kz

# Database (PostgreSQL 16)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=furnicore_db
DB_USER=furnicore_user
DB_PASSWORD=change-to-a-strong-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=600

# Security & HTTPS (Defaults to True when DEBUG=False)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Logging
LOG_LEVEL=INFO

# Celery & Redis (Optional / Async workers)
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Company & Localization
COMPANY_NAME="FurniCore ERP"
CURRENCY_CODE=KZT
CURRENCY_SYMBOL=₸
TIME_ZONE=Asia/Almaty
LANGUAGE_CODE=ru-ru

# AI Assistant (Optional LLM Integration)
LLM_API_KEY=
